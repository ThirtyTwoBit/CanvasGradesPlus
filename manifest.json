{
  "manifest_version": 3,
  "name": "Canvas Grades Plus",
  "version": "1.0",
  "description": "An easy way to keep track of your assignments. Adds an option to view grades and assignments for ALL your classes on a single popup.",
   "host_permissions": [
    "https://murraystate.instructure.com/*"
  ],
  "action": {
    "default_icon": "myCanvas_icon.png"
  },
  "web_accessible_resources": [
        {
            "resources": [
              "myCanvas_pen.svg"
              ],
            "matches": ["https://murraystate.instructure.com/*"]
        }
    ],
  "content_scripts": [
    {
      "matches": [
        "https://murraystate.instructure.com/*"
      ],
      "css":["classchecker.css"],
      "js": [
        "classchecker.js"
      ]
    }
  ]
}   